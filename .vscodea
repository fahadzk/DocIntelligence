{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to Document Intelligence",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "127.0.0.1",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/backend",
                    "remoteRoot": "${workspaceFolder}/backend"
                }
            ],
            "justMyCode": true
        }
    ]
}